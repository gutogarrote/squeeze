{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "deploy": "npm run build && wrangler deploy --config ../wrangler.jsonc",
    "dev:assets": "npm run build && wrangler dev --local --config ../wrangler.jsonc",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "13.5.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": "26.13.0"
  }
}
